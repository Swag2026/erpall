# ── Two separate databases, one backend ───────────────────────────────────────
# Retail keeps using its existing database (the old DATABASE_URL still works as a fallback for Retail).
DATABASE_URL_RETAIL=postgresql://USER:PASS@db:5432/swag_gold_retail
DATABASE_URL_BULLION=postgresql://USER:PASS@db:5432/swag_gold_bullion

# One SECRET_KEY signs the tokens of both apps (each token also carries which app it belongs to).
SECRET_KEY=change-me-to-a-long-random-string-of-32+-chars
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Both frontends' origins, comma separated
ALLOWED_ORIGINS=https://goldpos.swag.sa,https://swag-gold-react.vercel.app

# unchanged from before (copy from the current .env): EXTERNAL_API_*, TURN_*, VAPID_*
